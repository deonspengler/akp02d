# Maintainer: Deon Spengler <deon@spengler.co.za>
pkgname=akp02d
pkgver=1.0.0
pkgrel=1
pkgdesc="Themed system stats display for the Ajazz AKP02 panel, with a live theme editor"
arch=('any')
url="https://github.com/deonspengler/akp02d"
license=('GPL-3.0-or-later')
depends=('python>=3.13' 'python-akp02>=2.0.0' 'python-pillow' 'cava')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
checkdepends=('python-pytest' 'pyside6')
optdepends=('pyside6: the theme editor, akp02d-edit'
            'playerctl: the now_playing source and cover art'
            'libpulse: the volume source (pactl; works with PipeWire too)')
source=("$pkgname-$pkgver.tar.gz::https://github.com/deonspengler/akp02d/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # run updpkgsums once the v1.0.0 tag is on GitHub

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen PYTHONPATH="$PWD" python -m pytest -q
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 contrib/akp02d.service "$pkgdir/usr/lib/systemd/user/akp02d.service"
}
